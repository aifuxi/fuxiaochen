  {
    "id": "backfill.comment.authorKind",
    "label": "保留历史评论身份",
    "summary": "历史回复均来自管理员；显式保存身份以支持读者回复",
    "operationClass": "data",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "comment"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "历史回复均来自管理员；显式保存身份以支持读者回复",
        "sql": "UPDATE comment SET authorKind = CASE WHEN adminId IS NOT NULL OR parentId IS NOT NULL THEN 'admin' ELSE 'reader' END"
      }
    ],
    "postcheck": []
  },
