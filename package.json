{
  "name": "fuxiaochen",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:inspect": "oxlint --print-config",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "commit": "cz",
    "commit:retry": "cz --retry",
    "predev": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "db:generate": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "prisma db verify",
    "typecheck": "tsc --noEmit",
    "admin:init": "node --conditions=react-server --import tsx scripts/admin.ts init",
    "admin:reset-password": "node --conditions=react-server --import tsx scripts/admin.ts reset-password",
    "media:cleanup": "node --conditions=react-server --import tsx scripts/media-cleanup.ts",
    "posts:migrate-content": "node --conditions=react-server --import tsx scripts/migrate-post-content.ts"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.7",
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@base-ui/react": "^1.8.0",
    "@hono/vercel": "1.0.0",
    "@hono/zod-validator": "0.9.1",
    "@noble/hashes": "2.4.0",
    "@prisma/orm-sqlite": "8.0.0-rc.14",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-drag-handle": "3.31.4",
    "@tiptap/extension-drag-handle-react": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/static-renderer": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "argon2": "0.45.1",
    "border-beam": "^1.4.1",
    "clsx": "^2.1.1",
    "dotenv": "18.0.5",
    "highlight.js": "11.11.1",
    "hono": "4.13.12",
    "lowlight": "3.3.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@inquirer/prompts": "8.7.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss": "^8.5.6",
    "prisma": "8.0.0-rc.19",
    "tailwindcss": "^4.1.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@prisma/cli-engine": "0.6.2",
    "@prisma/dev": {
      "hono": "4.13.12",
      "@hono/node-server": "1.19.17",
      "valibot": "1.4.2"
    },
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lodash": "4.18.1",
    "prisma": {
      "@prisma/orm-toolchain": "8.0.0-rc.14"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint"
    ],
    "*.{json,jsonc,json5,md,mdx,css,scss,yaml,yml}": "oxfmt --write"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">= 24"
  }
}
