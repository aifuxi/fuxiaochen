# 在 Portainer 创建 Stack 时导入本文件；不要提交填写后的凭据。
# 等待单镜像发布成功后填写 SHA 标签或 digest；示例占位值不能直接部署。
APP_IMAGE=ghcr.io/aifuxi/fuxiaochen:sha-REPLACE_WITH_FULL_COMMIT_SHA
APP_ORIGIN=https://fuxiaochen.com
# 会话签名密钥：用 node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))" 生成。
# 至少 32 个字符，所有 Web 实例使用同一私有值；不提交 Git，替换后需重新登录。
BETTER_AUTH_SECRET=

# 必须先创建独立新卷并导入 /app/data/database.sqlite；旧 PostgreSQL 与历史 SQLite 卷保留。
APP_DATA_VOLUME=fuxiaochen-sqlite
# 既有站点固定 0。仅全新站点临时设为 1，确认初始化后改回 0。
SQLITE_INITIALIZE=0
# 仅恢复时填写 /app/data/ 下独立且不存在的新文件路径。
RESTORE_DATABASE_PATH=

# 应用复用现有 gateway 外部网络，不发布宿主机端口。
CADDY_NETWORK=infra_edge
# Caddy 覆盖 X-Real-IP 且应用不能公网直连后，才配置为 x-real-ip。
ANALYTICS_CLIENT_IP_HEADER=

OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_SERVER_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_SERVER_ENDPOINT_MODE=service
OSS_UPLOAD_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_UPLOAD_ENDPOINT_MODE=service
OSS_PUBLIC_ORIGIN=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_CREDENTIAL_MODE=environment
OSS_RAM_ROLE_NAME=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
