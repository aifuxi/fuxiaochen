# 在 Portainer 创建 Stack 时导入本文件；不要提交填写后的凭据。
# 当前功能分支的镜像标签为 feat-shiguang-notes，master 构建后才会发布 latest。
APP_IMAGE=ghcr.io/aifuxi/fuxiaochen:latest
APP_ORIGIN=https://fuxiaochen.com
APP_DATA_VOLUME=fuxiaochen-data

# 服务器 gateway 已接入这个外部网络，应用复用该网络，不发布宿主机端口。
CADDY_NETWORK=infra_edge
# Caddy 覆盖 X-Real-IP 且应用不能公网直连后，才配置为 x-real-ip。
ANALYTICS_CLIENT_IP_HEADER=

OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_SERVER_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_SERVER_ENDPOINT_MODE=service
OSS_UPLOAD_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_UPLOAD_ENDPOINT_MODE=service
OSS_PUBLIC_ORIGIN=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_CREDENTIAL_MODE=environment
OSS_RAM_ROLE_NAME=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
