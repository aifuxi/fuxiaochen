DATABASE_PATH=./data/admin.sqlite
APP_ORIGIN=http://localhost:3000

# OSS：endpoint 与公开域名使用 HTTPS origin，不带路径或查询参数。
# service 表示标准 S3 服务 endpoint；bucket 表示已绑定该 Bucket 的 CNAME。
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_SERVER_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_SERVER_ENDPOINT_MODE=service
OSS_UPLOAD_ENDPOINT=https://upload.example.com
OSS_UPLOAD_ENDPOINT_MODE=bucket
OSS_PUBLIC_ORIGIN=https://media.example.com

# 本地用 environment；ECS 部署改为 ecs_ram_role，不设置长期 AccessKey。
OSS_CREDENTIAL_MODE=environment
OSS_RAM_ROLE_NAME=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 仅本地临时 STS 凭证需要；过期后应更新环境并重启。
ALIBABA_CLOUD_SECURITY_TOKEN=
