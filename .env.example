# 本地 PostgreSQL：密码修改时同步修改 DATABASE_URL，并进行 URL 编码。
POSTGRES_ADMIN_PASSWORD=local_admin_change_me
POSTGRES_APP_PASSWORD=local_app_change_me
DATABASE_URL=postgresql://fuxiaochen:local_app_change_me@127.0.0.1:15433/fuxiaochen_dev
APP_ORIGIN=http://localhost:3000
# 仅恢复时填写，数据库名必须与当前应用不同，目标需预先创建且为空。
RESTORE_DATABASE_URL=

# 数据库备份目录，留空时使用 ./data/backups/。只备份数据库，不备份 OSS 文件。
# 目录应位于持久磁盘且由当前服务账号独占；不得放入 public/ 或提交到 Git。
BACKUP_DIRECTORY=

# 本地连接 OSS：使用默认外网域名，不配置 ECS、CNAME 或自有证书。
# 图片 20 MiB、附件 100 MiB 的上限由 lib/media/schema.ts 统一设置，无需额外 OSS 环境变量。
# 先确认账号及 Bucket 可使用默认公网域名；中国内地新开通账号可能受访问策略限制。
# 两个 endpoint 填同一地域的 S3 服务地址，不加桶名前缀，mode 均为 service。
OSS_BUCKET=
OSS_REGION=cn-hangzhou
OSS_SERVER_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_SERVER_ENDPOINT_MODE=service
OSS_UPLOAD_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_UPLOAD_ENDPOINT_MODE=service
# 把 your-bucket 换成 OSS_BUCKET 的实际值；修改地域时同步修改以上地址和此地址。
# 这里使用默认 Bucket 访问域名，不使用 S3 服务地址；HTTPS origin 不带路径或查询参数。
OSS_PUBLIC_ORIGIN=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# 本地 Node.js 读取最小权限 RAM 用户凭证；密钥仅填入未提交的 .env。
OSS_CREDENTIAL_MODE=environment
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 使用 RAM 用户 AccessKey 时留空；仅临时 STS 凭证需要，过期后更新环境并重启。
ALIBABA_CLOUD_SECURITY_TOKEN=

# 本地统计的可信单值 IP 请求头；默认未知。仅在代理覆盖该头且禁止直连应用时配置。
# 例如 nginx: proxy_set_header X-Real-IP $remote_addr;
ANALYTICS_CLIENT_IP_HEADER=
